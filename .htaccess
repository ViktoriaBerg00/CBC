Options -MultiViews
DirectoryIndex home.html
RewriteEngine On

# Canonical HTTPS host.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^copenhagenboxcup\.com$ [NC]
RewriteRule ^ https://copenhagenboxcup.com%{REQUEST_URI} [R=301,L,NE]

# Home and legacy URLs. THE_REQUEST prevents redirects on internal rewrites.
RewriteRule ^$ /home [R=301,L]
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ /home [R=301,L]
RewriteCond %{THE_REQUEST} \s/+((?:home|program|registration|rules|stay-venue|sponsors|tickets))\.html(?:[?\s]) [NC]
RewriteRule ^(home|program|registration|rules|stay-venue|sponsors|tickets)\.html$ /$1 [R=301,L]
RewriteRule ^(home|program|registration|rules|stay-venue|sponsors|tickets)/$ /$1 [R=301,L]

# Serve the existing HTML files at clean public addresses.
RewriteRule ^(home|program|registration|rules|stay-venue|sponsors|tickets)$ $1.html [END]
